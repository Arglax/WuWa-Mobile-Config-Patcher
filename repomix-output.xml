<file path="css/style.css">
/**
 * WuWa Mobile Config Patcher — Documentation Site Stylesheet (v1.5.0)
 */
:root {
    --bg-main: #06100e;
    --bg-surface: #0c1917;
    --bg-card: #122420;
    --bg-header: #0c1917;
    --border-color: rgba(45, 212, 191, 0.22);
    --accent-cyan: #2dd4bf;
    --accent-gold: #f59e0b;
    --accent-green: #10b981;
    --accent-red: #ef4444;
    --text-main: #f0fdfa;
    --text-muted: #94a3b8;
    --sidebar-width: 280px;

    /* Backend Badge Colors */
    --badge-root: #E35D6A;
    --badge-shizuku: #47D764;
    --badge-axmanager: #2AA37D;
    --badge-unauthorized: #F7C948;
    --badge-none: #A8B4AF;
    --flagged-red: #FF2222;
}

/* Eye-Friendly Soft Light Theme */
[data-theme="light"] {
    --bg-main: #f0f7f5;
    --bg-surface: #ffffff;
    --bg-card: #e1f0ec;
    --bg-header: #ffffff;
    --border-color: #b8ded6;
    --accent-cyan: #0d9488;
    --accent-gold: #d97706;
    --accent-green: #059669;
    --accent-red: #dc2626;
    --text-main: #08201a;
    --text-muted: #3b635a;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background-color: var(--bg-main);
    color: var(--text-main);
    line-height: 1.6;
    transition: background-color 0.25s ease, color 0.25s ease;
}

.hidden {
    display: none !important;
}

/* ==========================================================================
   Header & Search Box
   ========================================================================== */
.app-header {
    height: 70px;
    background-color: var(--bg-header);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    position: sticky;
    top: 0;
    z-index: 100;
    transition: background-color 0.25s ease, border-color 0.25s ease;
}

.header-brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.brand-logo {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid var(--border-color);
}

.header-brand h1 {
    font-size: 18px;
    font-weight: 800;
    color: var(--text-main);
}

.version-badge {
    font-size: 11px;
    font-weight: 700;
    color: var(--accent-gold);
    background: rgba(245, 158, 11, 0.15);
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid rgba(245, 158, 11, 0.3);
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
}

/* Hamburger toggle — injected into .app-header by initMobileNav() in js/main.js */
.mobile-nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    color: var(--text-main);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    margin-right: 8px;
    position: relative;
    z-index: 600;
}

.mobile-nav-toggle:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
}

/* Theme Toggle Button */
.theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
}

.theme-toggle-btn:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
}

.search-box {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
}

.search-icon {
    position: absolute;
    left: 12px;
    font-size: 14px;
    color: var(--text-muted);
}

.search-box input {
    background-color: var(--bg-main);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 8px 12px 8px 36px;
    color: var(--text-main);
    font-size: 13px;
    width: 220px;
    max-width: 100%;
    min-width: 0;
    transition: all 0.2s ease;
}

.search-box input:focus {
    outline: none;
    border-color: var(--accent-cyan);
    box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.2);
}

.github-link {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 10px;
    transition: all 0.2s ease;
}

.github-link:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
}

.github-link {
    flex-shrink: 0;
}

/* .github-link-text span is wrapped around the link's text node at runtime by js/main.js so it
   can be hidden independently of the SVG icon on narrow screens (see responsive block below). */

/* ==========================================================================
   Search Dropdown Results
   ========================================================================== */
.search-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 340px;
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.6);
    max-height: 380px;
    overflow-y: auto;
    z-index: 200;
}

.search-result-item {
    display: flex;
    padding: 12px 14px;
    text-decoration: none;
    border-bottom: 1px solid var(--border-color);
    transition: background 0.15s ease;
    cursor: pointer;
}

.search-result-item:hover, .search-result-item.selected {
    background: rgba(45, 212, 191, 0.15);
    border-left: 3px solid var(--accent-cyan);
}

.result-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
}

.result-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
}

.result-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent-gold);
}

.result-section {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--accent-cyan);
    background: rgba(45, 212, 191, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    white-space: nowrap;
    margin-left: 8px;
}

.result-snippet {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.search-result-item mark {
    background-color: rgba(245, 158, 11, 0.25);
    color: var(--accent-gold);
    border-radius: 2px;
    padding: 0 2px;
}

.search-no-results {
    padding: 14px;
    color: var(--text-muted);
    font-size: 13px;
    text-align: center;
}

/* ==========================================================================
   Main Container & Sidebar
   ========================================================================== */
.main-container {
    display: flex;
    min-height: calc(100vh - 120px);
}

.sidebar {
    width: var(--sidebar-width);
    background-color: var(--bg-surface);
    border-right: 1px solid var(--border-color);
    padding: 24px 16px;
    position: sticky;
    top: 70px;
    height: calc(100vh - 70px);
    overflow-y: auto;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
}

/* Backdrop behind the off-canvas sidebar on mobile — injected by initMobileNav() in js/main.js */
.sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    /* Below .app-header's z-index (100) on purpose: the header has an opaque background, so it
       stays visually intact and the hamburger button stays clickable while the overlay dims the
       content behind it. Still above the sidebar drawer's content siblings. */
    z-index: 90;
    opacity: 0;
    transition: opacity 0.25s ease;
}

.sidebar-overlay.active {
    display: block;
    opacity: 1;
}

body.nav-locked {
    overflow: hidden;
}

.sidebar-section {
    margin-bottom: 24px;
}

.sidebar-section h3 {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent-cyan);
    margin-bottom: 12px;
    padding-left: 8px;
}

.sidebar-section ul {
    list-style: none;
}

.sidebar-section li {
    margin-bottom: 4px;
}

.nav-link {
    display: block;
    padding: 8px 12px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    border-radius: 8px;
    transition: all 0.15s ease;
}

.nav-link:hover, .nav-link.active {
    background-color: rgba(45, 212, 191, 0.15);
    color: var(--accent-cyan);
}

/* ==========================================================================
   Content Area & Typography
   ========================================================================== */
.content-area {
    flex: 1;
    min-width: 0; 
    padding: 2rem 4%;
}

.doc-section {
    margin-bottom: 48px;
    scroll-margin-top: 90px;
}

.section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 12px;
    margin-bottom: 20px;
}

.section-header h2 {
    font-size: 22px;
    font-weight: 800;
    color: var(--accent-gold);
}

.doc-section h3 {
    font-size: 1.4rem;
    margin: 2rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-main);
}

.doc-section h4 {
    font-size: 1.15rem;
    margin: 1.5rem 0 0.75rem;
    color: var(--accent-cyan);
}

.doc-section p, .doc-section ul, .doc-section ol {
    line-height: 1.7;
    margin-bottom: 1.25rem;
    color: var(--text-main);
}

.doc-section ul, .doc-section ol {
    padding-left: 1.5rem;
}

.doc-section li {
    margin-bottom: 0.5rem;
}

.doc-section hr {
    border: 0;
    height: 1px;
    background: var(--border-color);
    margin: 2.5rem 0;
}

.author-tag {
    font-size: 12px;
    color: var(--text-muted);
    font-weight: 600;
}

.lead-text {
    font-size: 15px;
    color: var(--text-main);
    margin-bottom: 24px;
}

/* Formatting Tags */
code {
    background-color: rgba(45, 212, 191, 0.15);
    color: var(--accent-cyan);
    border: 1px solid rgba(45, 212, 191, 0.3);
    padding: 2px 6px;
    border-radius: 6px;
    font-family: SFMono-Regular, Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.9em;
}

/* ==========================================================================
   Backend Status Badges & Highlighting
   ========================================================================== */
.badge-backend {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 800;
    color: #fff;
    letter-spacing: 0.5px;
}

.badge-root {
    background-color: rgba(227, 93, 106, 0.2);
    color: var(--badge-root);
    border: 1px solid var(--badge-root);
}

.badge-shizuku {
    background-color: rgba(71, 215, 100, 0.2);
    color: var(--badge-shizuku);
    border: 1px solid var(--badge-shizuku);
}

.badge-axmanager {
    background-color: rgba(42, 163, 125, 0.2);
    color: var(--badge-axmanager);
    border: 1px solid var(--badge-axmanager);
}

.badge-unauthorized {
    background-color: rgba(247, 201, 72, 0.2);
    color: var(--badge-unauthorized);
    border: 1px solid var(--badge-unauthorized);
}

.badge-none {
    background-color: rgba(168, 180, 175, 0.2);
    color: var(--badge-none);
    border: 1px solid var(--badge-none);
}

.guard-red-highlight, .cvar-flagged {
    color: var(--flagged-red) !important;
    font-weight: 800 !important;
}

/* ==========================================================================
   Cards & Grids
   ========================================================================== */
.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
    margin-top: 20px;
}

.feature-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 20px;
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.25s ease;
}

.feature-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent-cyan);
}

.card-icon {
    font-size: 24px;
    margin-bottom: 10px;
}

.feature-card h4 {
    font-size: 15px;
    font-weight: 700;
    color: var(--accent-gold);
    margin: 0 0 6px 0;
}

.feature-card p {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 0;
}

/* Clickable Feature Cards */
.clickable-card {
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    position: relative;
    padding-bottom: 3.5rem;
}

.clickable-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.4);
    border-color: var(--accent-cyan);
}

.tech-link {
    position: absolute;
    bottom: 20px;
    left: 20px;
    font-size: 0.85rem;
    color: var(--accent-cyan);
    font-weight: 700;
    transition: color 0.2s ease;
}

.clickable-card:hover .tech-link {
    color: var(--accent-gold);
}

/* Alerts */
.alert {
    padding: 16px;
    border-radius: 12px;
    margin: 20px 0;
    font-size: 13.5px;
}

.alert-important {
    background-color: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.4);
    color: var(--text-main);
}

.alert-tip {
    background-color: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: var(--text-main);
}

.alert-warning {
    background-color: rgba(45, 212, 191, 0.12);
    border: 1px solid rgba(45, 212, 191, 0.4);
    color: var(--text-main);
}

.alert-title {
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
    color: var(--accent-gold);
}

/* Method Cards */
.method-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 16px;
}

.method-card h4 {
    font-size: 15px;
    font-weight: 700;
    color: var(--accent-cyan);
    margin: 0 0 12px 0;
}

.step-list {
    margin: 16px 0 24px 24px;
}

.step-list li {
    margin-bottom: 10px;
    font-size: 14px;
}

/* Tables & Frozen Column Table */
.doc-table {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    background-color: var(--bg-surface);
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    font-size: 13px;
}

.doc-table th, .doc-table td {
    padding: 12px 16px;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
}

.doc-table th {
    background-color: var(--bg-card);
    font-weight: 700;
    color: var(--accent-gold);
}

/* Auto-applied around plain .doc-table elements by initResponsiveTables() in js/main.js */
.table-scroll {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    margin: 20px 0;
    -webkit-overflow-scrolling: touch;
}

.table-scroll .doc-table {
    margin: 0;
    border: none;
    border-radius: 0;
    min-width: 480px;
}

.frozen-table-container {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    margin: 20px 0;
}

.frozen-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
}

.frozen-table th, .frozen-table td {
    padding: 12px 16px;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
    white-space: nowrap;
}

.frozen-table th {
    background-color: var(--bg-card);
    color: var(--accent-gold);
    font-weight: 700;
}

.frozen-table th.frozen-col, .frozen-table td.frozen-col {
    position: sticky;
    left: 0;
    background-color: var(--bg-surface);
    z-index: 10;
    border-right: 2px solid var(--border-color);
    font-weight: 700;
    color: var(--accent-gold);
}

.frozen-table th.frozen-col {
    background-color: var(--bg-card);
}

/* Editor Modes & Utilities Grids */
.editor-modes-container, .utilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin: 20px 0;
}

.editor-mode-box, .util-item {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 16px;
}

.mode-tag {
    display: inline-block;
    background-color: rgba(45, 212, 191, 0.15);
    color: var(--accent-cyan);
    font-size: 12px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 12px;
}

.editor-mode-box ul {
    list-style: none;
    font-size: 13px;
    padding-left: 0;
}

.editor-mode-box li {
    margin-bottom: 8px;
    position: relative;
    padding-left: 16px;
}

.editor-mode-box li::before {
    content: "•";
    color: var(--accent-gold);
    position: absolute;
    left: 0;
}

.util-item h4 {
    color: var(--accent-gold);
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 6px 0;
}

.util-item p {
    font-size: 12.5px;
    color: var(--text-muted);
    margin-bottom: 0;
}

/* ==========================================================================
   Code Blocks & Copy Button
   ========================================================================== */
.code-block {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    margin: 16px 0;
    position: relative;
}

.code-header {
    background-color: var(--bg-card);
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 700;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-color);
}

.code-block pre {
    padding: 16px;
    overflow-x: auto;
    font-family: SFMono-Regular, Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 12.5px;
    color: var(--accent-gold);
}

.copy-code-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-main);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.copy-code-btn:hover {
    background: rgba(255, 255, 255, 0.2);
}

.copy-code-btn.copied {
    background: var(--accent-green);
    color: #fff;
    border-color: var(--accent-green);
}

/* ==========================================================================
   Responsive Screenshot Grids (Strict User Formatting Constraint)
   ========================================================================== */
.screenshot-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 2rem 0;
    align-items: start;
}

.screenshot-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, transform 0.2s ease;
}

.screenshot-card:hover {
    border-color: var(--accent-cyan);
    transform: translateY(-2px);
}

.screenshot-img {
    width: 100%;
    height: auto;
    display: block;
    border-bottom: 1px solid var(--border-color);
}

.screenshot-caption {
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text-main);
    padding: 1.25rem 1.25rem 0.25rem;
}

.screenshot-subtext {
    font-size: 0.9rem;
    color: var(--text-muted);
    padding: 0 1.25rem 1.25rem;
    line-height: 1.5;
}

/* ==========================================================================
   Dual-Tab Modal Architecture
   ========================================================================== */
.modal-overlay {
    display: none;
    position: fixed;
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%;
    background: rgba(6, 16, 14, 0.85);
    backdrop-filter: blur(4px);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.modal-overlay.active {
    display: flex;
    opacity: 1;
}

.modal-window {
    background: var(--bg-surface);
    width: 92%;
    max-width: 650px;
    border-radius: 14px;
    border: 1px solid var(--border-color);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7);
    overflow: hidden;
    transform: scale(0.95);
    transition: transform 0.3s ease;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
}

.modal-overlay.active .modal-window {
    transform: scale(1);
}

.modal-header {
    background: var(--bg-header);
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.modal-header h3 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--accent-gold);
    font-weight: 800;
}

.close-btn {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--text-muted);
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
}

.close-btn:hover {
    color: var(--accent-red);
    background: rgba(239, 68, 68, 0.1);
}

.modal-tabs {
    display: flex;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border-color);
    padding: 6px 16px 0;
    gap: 8px;
}

.modal-tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 700;
    padding: 10px 14px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.modal-tab:hover {
    color: var(--text-main);
}

.modal-tab.active {
    color: var(--accent-cyan);
    border-bottom-color: var(--accent-cyan);
}

.modal-body {
    padding: 1.5rem;
    line-height: 1.6;
    color: var(--text-main);
    font-size: 13.5px;
    overflow-y: auto;
    flex: 1;
}

.modal-section-block h4 {
    color: var(--accent-gold);
    font-size: 14px;
    font-weight: 800;
    margin-bottom: 10px;
}

.modal-footer {
    padding: 1rem 1.5rem;
    background: var(--bg-header);
    border-top: 1px solid var(--border-color);
