    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.ai-chat-fab:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.5);
}

.ai-chat-window {
    position: fixed;
    bottom: 80px;
    right: 24px;
    width: clamp(320px, 30vw, 420px);
