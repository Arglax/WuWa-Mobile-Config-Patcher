const CACHE_NAME = 'wuwa-docs-cache-v1.5.1';

const PRECACHE_URLS = [
  './',
  './index.html',
  './css/style.css',
  './js/main.js',
  './js/ai-chat.js',
  './js/ai-knowledge.js',
