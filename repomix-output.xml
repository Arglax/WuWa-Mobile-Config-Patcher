    border-radius: 12px 12px 12px 2px;
    padding: 10px 12px;
    font-size: 12.5px;
    line-height: 1.5;
}

/* Bubble overflow fix (word-break / long strings / code) */
.msg-bubble {
    max-width: 100%;
    overflow-x: hidden;
    word-break: break-word;
    overflow-wrap: anywhere;
    box-sizing: border-box;
}

.msg-bubble code,
.msg-bubble pre {
    max-width: 100%;
    white-space: pre-wrap;
    word-break: break-all;
    overflow-x: auto;
    box-sizing: border-box;
}

.msg-system {
    align-self: center;
}

.msg-bubble-system {
    background: rgba(245, 158, 11, 0.15);
    color: var(--accent-gold);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 11px;
    text-align: center;
}

.chat-doc-link {
    display: inline-block;
    margin-top: 6px;
    color: var(--accent-cyan);
    font-weight: 700;
    text-decoration: underline;
    font-size: 12px;
    word-break: break-all;
}

.prompt-chips-container {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
}

.prompt-chip {
