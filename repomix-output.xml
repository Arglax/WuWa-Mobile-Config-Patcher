    color: #fff;
    border: none;
    padding: 8px 14px;
    border-radius: 8px;
    font-weight: 800;
    cursor: pointer;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
}

.ai-chat-send-btn:hover {
    opacity: 0.9;
}

/* ==========================================================================
   Responsive Breakpoints
   900px = header/nav switches to hamburger + off-canvas sidebar drawer.
   768/600/480/420/380 = progressive tightening of header, content, grids,
   tables and the AI chat widget for phone-width viewports.
   ========================================================================== */

/* ---- 900px: header layout + off-canvas sidebar drawer ---- */
@media screen and (max-width: 900px) {
    .mobile-nav-toggle {
        display: inline-flex;
    }

    .sidebar {
        position: fixed;
        left: 0;
        top: 70px;
        height: calc(100vh - 70px);
        width: min(82vw, 300px);
        z-index: 500;
        transform: translateX(-100%);
        box-shadow: 8px 0 24px rgba(0, 0, 0, 0.5);
    }

    .sidebar.sidebar-open {
        transform: translateX(0);
    }

    .main-container {
        min-height: calc(100vh - 110px);
    }
}

/* ---- 768px: header controls shrink, content padding tightens ---- */
@media screen and (max-width: 768px) {
    .app-header {
        padding: 0 12px;
    }

    .header-brand {
        gap: 8px;
        min-width: 0;
    }

    .header-brand h1 {
        font-size: 15px;
        max-width: 38vw;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .version-badge {
        display: none;
    }

    .header-actions {
        gap: 6px;
    }

    .theme-toggle-btn {
        padding: 8px;
    }

    .theme-toggle-btn .theme-text {
        display: none;
    }

    .search-box {
        flex: 1 1 auto;
    }

    .search-box input {
        width: 100%;
    }

    .search-dropdown {
        position: fixed;
        top: 70px;
        left: 8px;
        right: 8px;
        width: auto;
        max-width: none;
    }

    .content-area {
        padding: 1.5rem 5%;
    }

    .screenshot-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .ai-chat-fab {
        bottom: 16px;
        right: 16px;
        padding: 8px 14px;
        font-size: 12px;
    }
    .ai-chat-window {
        bottom: 68px;
        right: 16px;
        left: 16px;
        width: auto;
        max-width: none;
        height: min(70vh, 70dvh);
        max-height: min(70vh, 70dvh);
    }
}

/* ---- 600px: GitHub label hides (icon-only), modal tightens ---- */
@media screen and (max-width: 600px) {
    .github-link-text {
        display: none;
    }
    .github-link {
        padding: 8px 10px;
    }

    .modal-window {
        width: 94%;
    }
    .modal-body {
        padding: 1rem;
    }
    .modal-header, .modal-footer {
        padding: 0.85rem 1rem;
    }
}

/* ---- 480px: brand truncates further, tables/grids go single-column ---- */
@media screen and (max-width: 480px) {
    .brand-logo {
        width: 32px;
        height: 32px;
    }
    .header-brand h1 {
        max-width: 28vw;
        font-size: 14px;
    }

    .content-area {
        padding: 1.25rem 4%;
    }
    .section-header h2 {
        font-size: 18px;
    }
    .doc-section h3 {
        font-size: 1.2rem;
    }

    .screenshot-grid {
        grid-template-columns: 1fr;
    }

    .doc-table th, .doc-table td,
    .frozen-table th, .frozen-table td {
        padding: 10px 12px;
        font-size: 12px;
    }
}

/* ---- 420px: AI chat FAB collapses to a real floating icon button ---- */
@media screen and (max-width: 420px) {
    .ai-chat-window {
        bottom: 60px;
        right: 8px;
        left: 8px;
        height: min(65vh, 65dvh);
    }
    .header-info h4 {
        font-size: 12px;
    }
    .ai-status {
        display: none;
    }
    .msg-bubble, .msg-ai .msg-bubble, .msg-user .msg-bubble {
        font-size: 12px;
    }

    .ai-chat-fab {
        width: 52px;
        height: 52px;
        padding: 0;
        border-radius: 50%;
        justify-content: center;
        bottom: 16px;
        right: 16px;
    }
    .ai-chat-fab .fab-label {
        display: none;
    }
    .ai-chat-fab .fab-icon {
        font-size: 22px;
    }
}

/* ---- 380px: last-resort single-column safety net for card grids ---- */
@media screen and (max-width: 380px) {
    .features-grid, .editor-modes-container, .utilities-grid {
        grid-template-columns: 1fr;
    }
    .header-brand h1 {
        max-width: 22vw;
    }
}

/* ==========================================================================
   Language Selector UI
   ========================================================================== */
.lang-selector-wrapper {
    display: flex;
    align-items: center;
    margin-right: 8px;
}

.lang-selector-container {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-main);
    cursor: pointer;
    transition: all 0.2s ease;
}

.lang-selector-container:hover {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
}

.lang-select-code {
    margin-right: 6px;
    text-transform: uppercase;
}

.lang-select-box {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
}

.lang-arrow {
    font-size: 10px;
    color: var(--text-muted);
}

/* Responsive adjustment for the header */
@media screen and (max-width: 768px) {
    .lang-select-code {
        display: none;
    }
    .lang-selector-container {
        padding: 8px 10px;
    }
}
