.ai-chat-input-row input {
    flex: 1;
    min-width: 0;
    background: var(--bg-main);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12.5px;
    box-sizing: border-box;
}

.ai-chat-input-row input:focus {
    outline: none;
    border-color: var(--accent-cyan);
}

.ai-chat-send-btn {
