      .replace(/won'?t/g, 'will not')
      .replace(/can'?t/g, 'can not')
      .replace(/n'?t\b/g, ' not')
      .replace(/'re\b/g, ' are')
      .replace(/'ll\b/g, ' will')
      .replace(/'ve\b/g, ' have')
      .replace(/'m\b/g, ' am')
      .replace(/c\s*#|c\s*sharp/g, 'csharp');

