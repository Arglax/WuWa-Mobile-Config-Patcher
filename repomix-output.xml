    const withCompounds = [];
    rawTokens.forEach(token => {
      withCompounds.push(token);
      const cleanToken = token.replace(/[\.\_\-]/g, '');
      if (COMPOUND_TERMS[cleanToken]) {
        withCompounds.push(...COMPOUND_TERMS[cleanToken]);
      }
    });
    return withCompounds;
  }

